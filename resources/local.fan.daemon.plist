<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference template. `sudo fan install` writes the real plist and fills in the
  admin group id automatically. To install manually, replace 80 with the gid from
  `dseditgroup -o read admin`.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.fan.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/fan</string>
    <string>daemon</string>
  </array>
  <key>Sockets</key>
  <dict>
    <key>Listener</key>
    <dict>
      <key>SockPathName</key>
      <string>/var/run/fan.sock</string>
      <key>SockPathOwner</key>
      <integer>0</integer>
      <key>SockPathGroup</key>
      <integer>80</integer>
      <key>SockPathMode</key>
      <integer>432</integer>
    </dict>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
